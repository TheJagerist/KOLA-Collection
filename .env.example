# Variables lues par docker-compose.yml (copier en .env pour personnaliser)
DB_DATABASE=kola
DB_USERNAME=kola
DB_PASSWORD=secret
DB_FORWARD_PORT=5433
API_FORWARD_PORT=8000
FRONT_FORWARD_PORT=5173
# mock = données simulées dans le navigateur ; http = API Laravel réelle
# vide = auto : en dev, l'API si elle répond, sinon la démo (bandeau d'avertissement). http / mock = forcé.
VITE_API_MODE=
