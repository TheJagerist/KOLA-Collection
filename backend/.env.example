APP_NAME="Kola Collection"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Compte administrateur créé par « php artisan db:seed » (changer en production !)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=kola
DB_USERNAME=kola
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@kolacollection.cg"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Connexion Google (à configurer — voir README-MANU.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# --- Kōlā -------------------------------------------------------------------
# E-mails prévenus à chaque nouvelle commande (séparés par des virgules ; en dev, MAIL_MAILER=log → storage/logs)
KOLA_NOTIFY_EMAILS=
# Alerte « stock bas » à partir de N articles restants par taille
KOLA_LOW_STOCK=3
# Paiement : vide = dépôt Mobile Money manuel (numéros, frais et consignes dans Admin → Paramètres)
#            fake = simulateur de paiement en ligne (dev) | cinetpay = paiement en ligne automatique
KOLA_PAYMENT_DRIVER=
# Alertes WhatsApp de l'équipe : callmebot (destinataires dans Admin → Paramètres) | log
KOLA_WHATSAPP_ALERTS=callmebot
CINETPAY_SITE_ID=
CINETPAY_API_KEY=

# Codes de connexion par SMS : log (dev, écrit dans storage/logs/laravel.log) | africastalking
KOLA_SMS_DRIVER=log
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Empreinte / Face ID : domaine du site (déduit de FRONTEND_URL si vide). En production : kolacollection.cg
KOLA_WEBAUTHN_RP_ID=
