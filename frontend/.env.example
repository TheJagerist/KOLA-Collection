# mock : données simulées dans le navigateur (aucun backend requis)
# http : appelle l'API Laravel (proxy Vite vers VITE_API_PROXY_TARGET)
# vide = auto : en dev, l'API si elle répond, sinon la démo (bandeau d'avertissement). http / mock = forcé.
VITE_API_MODE=
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_WHATSAPP_NUMBER=242064455563
# Afficher « Continuer avec Google » (à activer quand Socialite est configuré côté Laravel)
VITE_GOOGLE_AUTH=false
